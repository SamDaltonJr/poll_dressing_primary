rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dressings/{doc} { allow read, write; }
    match /distributionPoints/{doc} { allow read, write; }
    match /plannedSignLocations/{doc} { allow read, write; }
    match /signPickups/{doc} { allow read, write; }
    match /locationReports/{doc} { allow read, write; }

    // Big-sign submissions.
    match /submissions/{doc} { allow read, write; }

    // Statewide polling locations, one doc per county, written by the admin
    // CSV importer. Same open-write posture as the rest of the app (the admin
    // UI gate is client-side); shape checks just keep junk out.
    match /pollingLocationSets/{doc} {
      allow read;
      allow create, update: if request.resource.data.campaignId is string
                            && request.resource.data.county is string
                            && request.resource.data.locations is list;
      allow delete;
    }

    // Regional coordinators. Doc ID = sha256("<campaignId>:<login code>"), so
    // the ID itself is the credential check; codes are random 12-char strings.
    match /coordinators/{doc} {
      allow read;
      allow create, update: if request.resource.data.campaignId is string
                            && request.resource.data.name is string
                            && request.resource.data.counties is list;
      allow delete;
    }

    // Per-campaign auth + admin-managed coverage. Hash fields are write-locked
    // so client code can never overwrite the access codes.
    match /campaignSettings/{slug} {
      allow read;
      allow create: if !('accessCodeHash' in request.resource.data)
                    && !('adminPasswordHash' in request.resource.data);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['accessCodeHash', 'adminPasswordHash']);
      allow delete: if false;
    }

    match /config/{doc} { allow read; allow write: if false; }
  }
}
